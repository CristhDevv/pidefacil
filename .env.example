# ==============================================================================
# PIDEFÁCIL (.co) - CONFIGURACIÓN DE ENTORNO
# "Pide fácil, paga en casa" — E-commerce COD Colombia
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Autenticación Dropi Colombia (API v2)
# ------------------------------------------------------------------------------
# Ingrese su token JWT de sesión de Dropi (sin comillas o con comillas del localStorage)
# Puede configurarse aquí o en el archivo ignorado por Git: .secrets/dropi_token.txt
DROPI_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Si no se especifica, se extraerá automáticamente del claim `sub` del JWT
DROPI_USER_ID=
DROPI_COUNTRY=COLOMBIA
DROPI_API_BASE=https://api-v2.dropi.co

# ------------------------------------------------------------------------------
# 2. Configuración Comercial y Regla Matemática de Precios
# ------------------------------------------------------------------------------
# Margen objetivo en pesos colombianos (55000 - 60000 COP)
MARGIN_BASE_COP=55000

# Redondeo comercial obligado a terminación psicológica
PRICE_ENDING_TARGET=9900

# Porcentaje de descuento sobre la segunda unidad para el Dúo Pack (AOV Booster)
DUO_PACK_DISCOUNT_PERCENT=25

# ------------------------------------------------------------------------------
# 3. Base de Datos en la Nube (Supabase PostgreSQL para Vercel) y Local (SQLite)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://gmxgwtdmsetzjpyqrkgq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_PATH=./data/pidefacil.db
RAW_DATA_DIR=./data/raw

# ------------------------------------------------------------------------------
# 4. Administración y Seguridad
# ------------------------------------------------------------------------------
# Token de acceso para el panel operativo /admin
ADMIN_SECRET=Soloc@li1

# ------------------------------------------------------------------------------
# 5. Parámetros de Marca y WhatsApp
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME=PideFácil
NEXT_PUBLIC_STORE_SLOGAN=Pide fácil, paga en casa
NEXT_PUBLIC_WHATSAPP_NUMBER=573009123456
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Motor Creativo de IA (Google Gemini + Generación de Escenas)
# ------------------------------------------------------------------------------
# API Key de Google AI Studio (puede configurarse aquí o en caliente desde /admin)
GEMINI_API_KEY=
# Modelo de Imagen de Gemini para creación de escenas (Default: gemini-3.1-flash-image)
# Alternativas: gemini-3-pro-image (mayor fidelidad), gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
